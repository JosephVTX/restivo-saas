APP_NAME="Restivo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://restivo.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restivo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=restivo

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Tenancy
TENANCY_CACHE_STORE=redis
TENANCY_CACHE_TTL=3600
TENANCY_RATE_LIMIT_TENANT=300
TENANCY_RATE_LIMIT_GUEST=60

# Octane (production)
OCTANE_SERVER=frankenphp

VITE_APP_NAME="${APP_NAME}"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restivo
CLOUDINARY_MAX_IMAGES_PER_PRODUCT=2
CLOUDINARY_IMAGE_MAX_WIDTH=700
CLOUDINARY_WEBP_QUALITY=75
